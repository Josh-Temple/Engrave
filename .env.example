# Audio storage mode: `local` (default) or `supabase`.
# Supabase mode stores audio files only; cards/reviews remain local-first in browser storage.
VITE_AUDIO_STORAGE_MODE="local"

# Supabase project URL for browser client (required only when VITE_AUDIO_STORAGE_MODE=supabase).
VITE_SUPABASE_URL=""

# Supabase anon key for browser client (required only when VITE_AUDIO_STORAGE_MODE=supabase).
VITE_SUPABASE_ANON_KEY=""
